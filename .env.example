# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# DEV_SKIP_LOGIN: development-only login bypass.
# When "true", the app silently signs in anonymously and skips the sign-in screen.
# Set to "false" (or remove) before release to require real Google sign-in.
# Exposed to code as BuildConfig.DEV_SKIP_LOGIN via the Secrets Gradle Plugin.
DEV_SKIP_LOGIN=true

# USE_FIREBASE_EMULATOR: when "true", debug builds use the local Firebase Emulator Suite
# (auth 9099, firestore 8085) instead of the real project.
USE_FIREBASE_EMULATOR=false
